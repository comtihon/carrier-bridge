# ── LangGraph Backend ──────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ── LLM for CopilotKit (pick one) ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# CopilotKit LLM model (defaults shown)
# COPILOTKIT_MODEL=gpt-4o
# COPILOTKIT_LLM_PROVIDER=openai   # "openai" | "anthropic"

# ── OAuth2 / NextAuth ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Generic OIDC provider (matches backend OAUTH_JWKS_URL configuration)
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_ISSUER_URL=https://your-idp.example.com
# Optional: restrict to specific scopes
OAUTH_SCOPE=openid email profile

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "false" to disable auth entirely (matches backend OAUTH_ENABLED=false)
NEXT_PUBLIC_AUTH_ENABLED=false
# Show the raw JSON inspector panel in run detail view
NEXT_PUBLIC_SHOW_RAW_JSON=false
